# agent.py configuration — copy to .env and fill in values
# (or pass everything as CLI flags instead)

# Which provider to use: ollama | anthropic | openai
AGENT_PROVIDER=ollama

# ── Ollama (local, no key needed) ──────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# ── Anthropic ──────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-6

# ── OpenAI / OpenAI-compatible (LM Studio, vLLM, llama.cpp, …) ────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# For a local OpenAI-compatible server (e.g. LM Studio on port 1234):
# OPENAI_API_KEY=none
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=your-model-name
